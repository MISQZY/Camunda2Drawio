        <dc:Bounds x="1250" y="510" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_SubEnd_di" bpmnElement="EndEvent_SubEnd">
        <dc:Bounds x="1354" y="532" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BoundaryEvent_ShipTimeout_di" bpmnElement="BoundaryEvent_ShipTimeout">
        <dc:Bounds x="1180" y="612" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_ShipmentDelayed_di" bpmnElement="EndEvent_ShipmentDelayed">
        <dc:Bounds x="1260" y="612" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ShipOrder_di" bpmnElement="Task_ShipOrder">
        <dc:Bounds x="1420" y="510" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_ParallelJoin_di" bpmnElement="Gateway_ParallelJoin">
        <dc:Bounds x="1550" y="525" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_FinalCheck_di" bpmnElement="Gateway_FinalCheck">
        <dc:Bounds x="1650" y="525" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_OrdersComplete_di" bpmnElement="EndEvent_OrdersComplete">
        <dc:Bounds x="1760" y="532" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_ProcessPayment_di" bpmnElement="Task_ProcessPayment">
        <dc:Bounds x="880" y="730" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DataStoreRef_Orders_di" bpmnElement="DataStoreRef_Orders">
        <dc:Bounds x="890" y="680" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_PaymentEvent_di" bpmnElement="Gateway_PaymentEvent">
        <dc:Bounds x="1040" y="745" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="IntermediateCatchEvent_PaymentConfirmed_di" bpmnElement="IntermediateCatchEvent_PaymentConfirmed">
        <dc:Bounds x="1150" y="752" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="IntermediateCatchEvent_PaymentTimeout_di" bpmnElement="IntermediateCatchEvent_PaymentTimeout">
        <dc:Bounds x="1150" y="830" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_PaymentFailed_di" bpmnElement="EndEvent_PaymentFailed">
        <dc:Bounds x="1250" y="830" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Flow_C1_di" bpmnElement="Flow_C1">
        <di:waypoint x="116" y="100" />
        <di:waypoint x="160" y="100" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_C2_di" bpmnElement="Flow_C2">
        <di:waypoint x="260" y="100" />
        <di:waypoint x="320" y="100" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_C3_di" bpmnElement="Flow_C3">
        <di:waypoint x="356" y="100" />
        <di:waypoint x="420" y="100" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_S1_di" bpmnElement="Flow_S1">
        <di:waypoint x="136" y="330" />
        <di:waypoint x="180" y="330" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_S2_di" bpmnElement="Flow_S2">
        <di:waypoint x="280" y="330" />
        <di:waypoint x="340" y="330" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_S3_di" bpmnElement="Flow_S3">
        <di:waypoint x="390" y="330" />
        <di:waypoint x="440" y="330" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_S4_di" bpmnElement="Flow_S4">
        <di:waypoint x="365" y="355" />
        <di:waypoint x="365" y="400" />
        <di:waypoint x="420" y="400" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_S5_di" bpmnElement="Flow_S5">
        <di:waypoint x="540" y="330" />
        <di:waypoint x="600" y="330" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_S6_di" bpmnElement="Flow_S6">
        <di:waypoint x="625" y="305" />
        <di:waypoint x="625" y="270" />
        <di:waypoint x="680" y="270" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_S7_di" bpmnElement="Flow_S7">
        <di:waypoint x="780" y="270" />
        <di:waypoint x="825" y="270" />
        <di:waypoint x="825" y="305" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_S8_di" bpmnElement="Flow_S8">
        <di:waypoint x="650" y="330" />
        <di:waypoint x="800" y="330" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_S9_di" bpmnElement="Flow_S9">
        <di:waypoint x="850" y="330" />
        <di:waypoint x="900" y="330" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_X1_di" bpmnElement="Flow_X1">
        <di:waypoint x="925" y="355" />
        <di:waypoint x="925" y="550" />
        <di:waypoint x="880" y="550" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_X2_di" bpmnElement="Flow_X2">
        <di:waypoint x="950" y="330" />
        <di:waypoint x="970" y="330" />
        <di:waypoint x="970" y="770" />
        <di:waypoint x="880" y="770" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Flow_W1_di" bpmnElement="Flow_W1">
        <di:waypoint x="980" y="550" />
        <di:waypoint x="1020" y="550" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_W2_di" bpmnElement="Flow_W2">
        <di:waypoint x="1400" y="550" />
        <di:waypoint x="1420" y="550" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_W3_di" bpmnElement="Flow_W3">
        <di:waypoint x="1216" y="630" />
        <di:waypoint x="1260" y="630" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_W4_di" bpmnElement="Flow_W4">
